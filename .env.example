# Copy to .env and fill in. .env is gitignored; never commit real values.

# Resend API key for the contact form (server-side only, never VITE_-prefixed).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides for the contact form.
# CONTACT_TO defaults to bhnsadhu@gmail.com, the address that owns the Resend
#   key. While the sender is onboarding@resend.dev, Resend refuses every other
#   recipient. Verify a domain to send elsewhere.
# CONTACT_FROM defaults to "Portfolio <onboarding@resend.dev>"
CONTACT_TO=
CONTACT_FROM=

# Absolute origin used for social preview image URLs. Set this in Vercel too.
VITE_SITE_URL=
