# Copy to .env and fill in. .env is gitignored; never commit real values.

# Resend API key for the contact form (server-side only, never VITE_-prefixed).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides for the contact form.
# CONTACT_TO defaults to sadhubhanu07@gmail.com
# CONTACT_FROM defaults to "Portfolio <hello@bhanusadhu.com>", on the verified
#   bhanusadhu.com domain. Any sender must be on a domain verified in Resend.
CONTACT_TO=
CONTACT_FROM=
